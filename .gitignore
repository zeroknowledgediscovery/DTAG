# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/

# Editor / OS
.DS_Store
*~

# Generated DTAG outputs
outputs/*
!outputs/.gitkeep

# Generated runtime caches
assets/*.possible.*.json
assets/*.semantic_embeddings.*.json
assets/**/*.possible.*.json
assets/**/*.semantic_embeddings.*.json

# Raw survey data and local source documentation are not release artifacts
data/raw/*
data/**/codebooks/*.pdf

# Logs
*.log

# Native LSM model artifacts are distributed outside Git
/models/lsm/**
!/models/lsm/README.md

# Legacy top-level model trees must never be reintroduced.
/models/gss/
/models/wvs/
/models/afrobarometer/

# Bundled native LSM build products
# Prebuilt Linux CPython extension is intentionally trackable; build directory
# and non-Linux binary variants remain local.
native/lsm_runtime/build/
native/lsm_runtime/python/*.pyd
native/lsm_runtime/python/*.dylib

# Public GCS model corpus / local model-release staging
# Actual native models and generated archives belong in GCS, never Git.
/models/releases/
/models/public_releases/
/dtag-models-*/
/*.dtag-model-release/

# DTAG web application: dependencies and local runtime data
webapp/frontend/node_modules/
webapp/frontend/tsconfig.tsbuildinfo
webapp/data/*
!webapp/data/.gitkeep
!webapp/data/README.md
webapp/.env

# Local empirical-pole discovery artifacts
poles/results/
experiments/

# Local optimizer working copy (cp configs/optimizer_gss2024_cm_wf_robust.yaml my.yaml)
/my.yaml

# Local virtual environments
/.venv-dtag/
.venv*/

# Private human-study analysis exports
/left_sessions.csv
/right_sessions.csv

# --- git-gcs managed artifacts ---
# Exact managed file/directory paths are appended below.
/private_analysis_hmac_key.bin
!/private_analysis_hmac_key.bin.gcs

# PRIVATE PARTICIPANT DATA: do not track Prolific payment rosters or keys.
# This protects future additions; old commits still require history cleanup.
/DEMOCRATIC_recruitment_right_push_prolific_summary_detailed_*.pdf
/REPUBLICAN_RECRUIOT_right_push_prolific_summary_detailed_*.pdf
/REPUBLICAN_recruitment_right_push_prolific_summary_detailed_*.pdf
*prolific*summary*detailed*.pdf
/private_analysis_hmac_key.bin
/private_analysis_hmac_key.bin.gcs
/PRIVATE_*.csv

# Derived participant-level trajectory exports are private (even when pseudonymized).
**/trajectories_*_PRIVATE.csv
**/trajectory_manifest_PRIVATE.json
/dtag-trajectories-*/
