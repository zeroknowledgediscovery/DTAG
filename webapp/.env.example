# DTAG web application settings. Copy to webapp/.env (never commit it).

# Required for live respondents. Read only by the server; never sent to the browser.
OPENAI_API_KEY=

# Password protection: when set, the whole app (except /api/health) requires
# this password. Use it whenever the server is reachable by others, and serve
# over HTTPS so the password is not sent in clear text.
# DTAG_PASSWORD=
# Optional: keep logins valid across restarts (any long random string), and
# login lifetime in hours (default 12).
# DTAG_SESSION_SECRET=
# DTAG_AUTH_HOURS=12

# Optional: override the DTAG-configured OpenAI model (default from configs: gpt-4.1-mini).
# DTAG_OPENAI_MODEL=
# Demo/testing without OpenAI: deterministic mock language layer (native anchors stay real).
# DTAG_LLM_BACKEND=mock

# Native model cache (default ~/.cache/dtag/models). Mount a persistent volume here in containers.
# DTAG_MODEL_ROOT=
# Public model release (anonymous HTTPS; no cloud credentials needed).
DTAG_MODEL_RELEASE=v0.2.0
DTAG_PUBLIC_BUCKET=git-zeroknowledgediscovery-dtag
# DTAG_MODEL_MANIFEST_URL=

# DTAG configuration file (default: configs/dtag_config.yaml in the DTAG runtime tree).
# DTAG_CONFIG=
# Eurobarometer fieldwork-date registry (default: configs/eurodates.csv when present).
# DTAG_EURODATES=

# Web server.
DTAG_HOST=127.0.0.1
DTAG_PORT=8000
# Custom profiles are stored here (default ~/.cache/dtag/webapp; run.sh uses webapp/data).
# DTAG_WEB_DATA_DIR=
# Semantic-embedding/possible-response caches (default ~/.cache/dtag/assets).
# DTAG_ASSETS_DIR=
# In-memory session store limits.
# DTAG_MAX_SESSIONS=200
# DTAG_SESSION_TTL_HOURS=24
# Native models kept resident in memory (least recently used released first).
# DTAG_MAX_LOADED_MODELS=6
