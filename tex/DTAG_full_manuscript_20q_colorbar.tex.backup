 local d=os.getenv("DTAG_FIGURES_DIR")
 if d and d~="" then tex.sprint("\\gdef\\DTAGFigureDir{"..d.."}") end
}
% Read the native publication generator's JSON report; never hard-code run parameters.
\directlua{
 local p="\luaescapestring{\DTAGFigureDir}/optimization_report.json"
 local f=assert(io.open(p,"r"), "Missing optimization report: "..p)
 local s=f:read("*a"); f:close()
 local perc=string.char(37)
 local function readnum(k)
   local v=s:match('"'..k..'"'..perc..'s*:'..perc..'s*('..perc..'d+)')
   assert(v, "Missing numeric field "..k.." in "..p)
   return v
 end
 tex.sprint("\\gdef\\DTAGSteps{"..readnum("steps").."}")
 tex.sprint("\\gdef\\DTAGReps{"..readnum("reps").."}")
 tex.sprint("\\gdef\\DTAGIdMax{"..readnum("displayed_questions").."}")
 tex.sprint("\\gdef\\DTAGTotalQuestions{"..readnum("total_questions").."}")
 local people={"cm_rural_alabama","wf_new_york_city","religious_conservative_woman_texas",
 "secular_liberal_man_seattle","hispanic_catholic_man_arizona","black_churchgoing_woman_atlanta"}
 local function eachCSV(path,cb)
   local cf=assert(io.open(path,"r"),"Missing plot CSV: "..path)
   cf:read("*l")
   for row in cf:lines() do
     local c={}
     for v in row:gmatch('[^,]+') do table.insert(c,tonumber(v)) end
     if next(c)~=nil then cb(c) end
   end
   cf:close()
 end
 local e,t,o=0,0,0
 for _,policy in ipairs({"right","left","neutral","random"}) do
   eachCSV("\luaescapestring{\DTAGFigureDir}/pub_endpoint_"..policy..".csv",
     function(v) e=math.max(e, math.abs(v[2]-v[3]), math.abs(v[2]+v[4])) end)
   for _,person in ipairs(people) do
     eachCSV("\luaescapestring{\DTAGFigureDir}/pub_trajectory_"..person.."_"..policy..".csv",
       function(v) t=math.max(t,math.abs(v[3]),math.abs(v[4])) end)
   end
 end
 for _,policy in ipairs({"right","left","neutral"}) do
   for _,person in ipairs(people) do
     eachCSV("\luaescapestring{\DTAGFigureDir}/pub_order_"..person.."_"..policy..".csv",
       function(v) o=math.max(o, math.abs(v[2]-v[3]), math.abs(v[2]+v[4])) end)
   end
 end
 local function bound(x,floor) return string.format(string.char(37).."0.4f", math.max(x*1.16,floor)) end
 tex.sprint("\\gdef\\DTAGEndpointBound{"..bound(e,.02).."}")
 tex.sprint("\\gdef\\DTAGTrajectoryBound{"..bound(t,.02).."}")
 tex.sprint("\\gdef\\DTAGOrderBound{"..bound(o,.01).."}")
}
