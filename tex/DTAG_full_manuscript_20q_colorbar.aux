\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Question identities and fixed-item order effects over all six personas.} Left: 18 nearly square categorical heatmaps show 40{} independent runs over 20{} question positions. The single colorbar denotes optimized question IDs (blue: low; red: high), not signed ideological effects. A single globally optimized categorical map covers 161{} displayed items from 228{} observed questions. Right: original order versus reversal and two shuffles of fixed 20{}-item sets, displaying paired endpoint differences with 95\% bootstrap confidence intervals. The items are held fixed, and none of these model outcomes establish human persuasion.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:question-map}{{2}{6}{\textbf {Question identities and fixed-item order effects over all six personas.} Left: 18 nearly square categorical heatmaps show \DTAGReps {} independent runs over \DTAGSteps {} question positions. The single colorbar denotes optimized question IDs (blue: low; red: high), not signed ideological effects. A single globally optimized categorical map covers \DTAGIdMax {} displayed items from \DTAGTotalQuestions {} observed questions. Right: original order versus reversal and two shuffles of fixed \DTAGSteps {}-item sets, displaying paired endpoint differences with 95\% bootstrap confidence intervals. The items are held fixed, and none of these model outcomes establish human persuasion}{figure.2}{}}
\newlabel{fig:order-effects}{{2}{6}{\textbf {Question identities and fixed-item order effects over all six personas.} Left: 18 nearly square categorical heatmaps show \DTAGReps {} independent runs over \DTAGSteps {} question positions. The single colorbar denotes optimized question IDs (blue: low; red: high), not signed ideological effects. A single globally optimized categorical map covers \DTAGIdMax {} displayed items from \DTAGTotalQuestions {} observed questions. Right: original order versus reversal and two shuffles of fixed \DTAGSteps {}-item sets, displaying paired endpoint differences with 95\% bootstrap confidence intervals. The items are held fixed, and none of these model outcomes establish human persuasion}{figure.2}{}}
