\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Question identities and fixed-item directional displacement across six personas.} Left: 18 categorical heatmaps show 40{} runs over 20{} question positions, with a shared colorbar identifying questions rather than ideological direction. Right: baseline-relative displacement $I_{20}-I_0$ and 95\% bootstrap intervals for fixed optimized question sets replayed in reverse and two shuffled orders (40{} repetitions each). Right- and left-derived sets retain directional movement; neutral-derived sets remain near zero. These are fixed-set replays, not the fully adaptive runs in Fig.\nobreakspace  {}\ref {fig:arch_adaptive}.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:question-map}{{2}{5}{\textbf {Question identities and fixed-item directional displacement across six personas.} Left: 18 categorical heatmaps show \DTAGReps {} runs over \DTAGSteps {} question positions, with a shared colorbar identifying questions rather than ideological direction. Right: baseline-relative displacement $I_{20}-I_0$ and 95\% bootstrap intervals for fixed optimized question sets replayed in reverse and two shuffled orders (\DTAGReps {} repetitions each). Right- and left-derived sets retain directional movement; neutral-derived sets remain near zero. These are fixed-set replays, not the fully adaptive runs in Fig.~\ref {fig:arch_adaptive}}{figure.2}{}}
\newlabel{fig:order-effects}{{2}{5}{\textbf {Question identities and fixed-item directional displacement across six personas.} Left: 18 categorical heatmaps show \DTAGReps {} runs over \DTAGSteps {} question positions, with a shared colorbar identifying questions rather than ideological direction. Right: baseline-relative displacement $I_{20}-I_0$ and 95\% bootstrap intervals for fixed optimized question sets replayed in reverse and two shuffled orders (\DTAGReps {} repetitions each). Right- and left-derived sets retain directional movement; neutral-derived sets remain near zero. These are fixed-set replays, not the fully adaptive runs in Fig.~\ref {fig:arch_adaptive}}{figure.2}{}}
